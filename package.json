{
  "name": "flexsheet-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "FlexSheet monorepo — 模块化 + 插件化电子表格内核",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -r run build && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@types/pako": "^2.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^20.8.9",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "flexsheet": "workspace:*"
  }
}
